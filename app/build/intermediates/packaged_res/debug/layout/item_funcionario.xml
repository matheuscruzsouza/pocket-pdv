<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="12dp"
    android:gravity="center_vertical">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvFuncNome"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nome do Funcionário"
            android:textStyle="bold"
            android:textColor="#111827"
            android:textSize="15sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="2dp">

            <TextView
                android:id="@+id/tvFuncCargo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Operador de Caixa"
                android:textColor="#4B5563"
                android:textSize="13sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=" • "
                android:textColor="#9CA3AF"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvFuncUsuario"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@operador"
                android:textColor="#6B7280"
                android:textSize="13sp"
                android:fontFamily="monospace" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/tvFuncStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="ATIVO"
        android:background="@drawable/badge_success"
        android:textColor="#065F46"
        android:textSize="11sp"
        android:textStyle="bold" />
</LinearLayout>
