<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/card_background"
    android:padding="12dp"
    android:layout_marginBottom="8dp">

    <!-- Topo: ID e Status -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="6dp">

        <TextView
            android:id="@+id/tvRelatorioVendaId"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Venda #1"
            android:textColor="#111827"
            android:textSize="14sp"
            android:textStyle="bold"
            android:fontFamily="monospace" />

        <TextView
            android:id="@+id/tvRelatorioVendaStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CONCLUIDA"
            android:background="@drawable/badge_success"
            android:textColor="#065F46"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Linha 1: Colaborador / Vendedor -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="3dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Operador: "
            android:textColor="#6B7280"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tvRelatorioVendaFuncionario"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Carlos Silva"
            android:textColor="#1F2937"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Linha 2: Data e Horário -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="6dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Data/Hora: "
            android:textColor="#6B7280"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tvRelatorioVendaData"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="29/09/2026 às 18:50"
            android:textColor="#4B5563"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Divisória sutil -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#F3F4F6"
        android:layout_marginBottom="6dp" />

    <!-- Rodapé do Card: Quantidade de Itens e Valor Total -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tvRelatorioVendaItens"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="3 itens comercializados"
            android:textColor="#4B5563"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvRelatorioVendaTotal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="R$ 43,50"
            android:textColor="#059669"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
